{
    "layer": "bottom",
    "height": 27,
    "spacing": 5,
    "modules-left": [
	    "hyprland/workspaces"
    ],
    "modules-right": [
        "network",
	"wireplumber",
        "battery"
    ],
    "modules-center": [
	    "clock"
    ],
    "clock": {
	"tooltip": false,
        "format": "{:%H:%M}"
    },
    "battery": {
        "states": {
            "critical": 20
        },
        "format": "<big>{icon}</big>  {capacity}",
        "format-full": "{icon} {capacity}",
        "format-charging": " {capacity}",
        "format-plugged": " {capacity}",
        "format-alt": "{icon} {time}",
        "format-icons": ["", "", "", "", ""],
	"interval": 30,
	"tooltip": false
    },
    "network": {
        "format-wifi": "<big>{icon}</big>",
	"format-icons": "",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip": false,
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "<big></big>"
    },
    "wireplumber": {
        "format": "<big>{icon}</big>  {volume}",
        "format-muted": "<big> </big>",
        "format-icons": ["", "", ""],
	"tooltip": false
    },
    "hyprland/workspaces": {
	    "format": "{name}"
    }

}
